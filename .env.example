# ========================================================
# 电力风险智能交底系统 - 环境变量配置示例
# --------------------------------------------------------
# 使用方法：复制本文件为 .env，填入真实值后再启动
#   1) Docker 部署：docker compose 会自动读取同目录 .env
#   2) 本地 java -jar 部署：设置同名环境变量即可
#   3) 本地 IDE 开发：把真实值写入 secrets-local.yml（已被 .gitignore 排除）
#
# ⚠ 本文件会进入 Git，只能出现占位符，严禁填写真实密钥
# ========================================================

# ---------- 数据库配置 ----------
MYSQL_PORT=3306
MYSQL_DATABASE=eledangercheck
MYSQL_USERNAME=root
# 数据库 root 密码（必填）
MYSQL_ROOT_PASSWORD=
# 应用侧读取的数据库密码（本地 java -jar 场景使用；Docker 场景由 compose 注入）
SPRING_DATASOURCE_PASSWORD=

# ---------- 应用配置 ----------
APP_PORT=8081
# JWT 签名密钥（必填，生产环境请使用 32 位以上随机字符串）
JWT_SECRET=

# ---------- DeepSeek API（在线大模型，AI对话必需）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- FastChat API（可选）----------
FASTCHAT_API_KEY=
FASTCHAT_BASE_URL=https://api.fastchat.cn

# ---------- 腾讯云 TIIA（图像识别/PPE检测，可选）----------
TENCENT_TIIA_ENABLED=false
TENCENT_TIIA_SECRET_ID=
TENCENT_TIIA_SECRET_KEY=
TENCENT_TIIA_REGION=ap-guangzhou

# ---------- Elasticsearch（可选，默认关闭）----------
ES_USERNAME=
ES_PASSWORD=

# ---------- 阿里云 TTS 语音合成（可选）----------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---------- e签宝 电子签章（可选）----------
ESIGN_APP_ID=
ESIGN_APP_SECRET=